{
  "agent": { "run_as_user": "root" },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/project17-app.log",
            "log_group_name": "pratham-project17-app",
            "log_stream_name": "{hostname}"
          },
          {
            "file_path": "/var/log/syslog",
            "log_group_name": "pratham-project17-syslog",
            "log_stream_name": "{hostname}"
          }
        ]
      }
    }
  }
}
